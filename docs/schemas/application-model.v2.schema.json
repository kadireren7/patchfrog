  "description": "Static application discovery result (discovery.json). Generated from patchfrog.scalability.project.domain; see docs/architecture/DISCOVERY.md.",
  "else": {
    "required": [
      "database"
    ]
  },
  "if": {
    "properties": {
      "schema_version": {
        "const": 1
      }
    }
  },
  "properties": {
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "database": {
      "$ref": "#/$defs/DatabaseModel"
    },
    "dependency_functions": {
      "items": {
        "$ref": "#/$defs/DependencyFunction"
      },
      "type": "array"
    },
    "frameworks": {
      "items": {
        "$ref": "#/$defs/FrameworkEvidence"
      },
      "type": "array"
    },
    "includes": {
      "items": {
        "$ref": "#/$defs/IncludeEdge"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/Limitation"
      },
      "type": "array"
    },
    "revision_id": {
      "type": "string"
    },
    "routers": {
      "items": {
        "$ref": "#/$defs/Router"
      },
      "type": "array"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/Route"
      },
      "type": "array"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/Unresolved"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "revision_id",
    "frameworks",
    "routers",
    "includes",
    "routes",
    "dependency_functions",
    "unresolved",
    "limitations",
    "coverage"
  ],
  "then": {
    "not": {
      "required": [
        "database"
      ]
    }
  },
  "title": "PatchFrog ApplicationModel",
  "type": "object"
}
