# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://patchfrog:patchfrog@localhost:5432/patchfrog
REDIS_URL=redis://localhost:6379/0

# GitHub App credentials — https://github.com/settings/apps
GITHUB_APP_ID=123456

# Set exactly ONE of the following two — GITHUB_PRIVATE_KEY_PATH is
# preferred, since it keeps the multiline PEM out of .env and the process
# environment. Both are resolved into the same in-memory value at startup.
#
# Option 1 (preferred): path to the .pem file downloaded from GitHub.
# GITHUB_PRIVATE_KEY_PATH=/path/to/your-github-app-private-key.pem
#
# Option 2: inline PEM. Escape newlines as \n if set on a single line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

GITHUB_WEBHOOK_SECRET=change-me

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT_SECONDS=10

# AI Reviewer -- operator/deployment-controlled provider/model selection
# (see patchfrog.review.runtime_config.ReviewRuntimeConfig). This is a
# trust/cost boundary: `.patchfrog.yml` (repository-controlled) cannot
# select or influence the AI provider/model/critic model/timeout at all
# -- only these environment variables can. Leave everything below unset
# to get the default (anthropic / claude-opus-5 / 30s timeout).
#
# PATCHFROG_REVIEW_PROVIDER=anthropic   # or: gemini
# PATCHFROG_REVIEW_MODEL=claude-opus-5  # e.g. gemini-3.6-flash for gemini
# PATCHFROG_REVIEW_CRITIC_MODEL=        # optional; defaults to the reviewer model
# PATCHFROG_REVIEW_REQUEST_TIMEOUT_SECONDS=  # optional; 30s default (120s default for gemini)
#
# Only the credential for the provider actually selected above needs to
# be set. Never set either of these in .patchfrog.yml or any
# repository-controlled file; environment/secret-manager only. Leave
# both unset to run static analysis and context generation without the
# AI reviewer -- `patchfrog.cli review` and the review Celery task both
# fail with a clear error (not a crash) if the *selected* provider's key
# is unset.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Gemini provider (patchfrog.review.providers.gemini_provider) -- select
# via PATCHFROG_REVIEW_PROVIDER=gemini above.
# GEMINI_API_KEY=...
