# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://patchfrog:patchfrog@localhost:5432/patchfrog
REDIS_URL=redis://localhost:6379/0

# GitHub App credentials — https://github.com/settings/apps
GITHUB_APP_ID=123456

# Set exactly ONE of the following two — GITHUB_PRIVATE_KEY_PATH is
# preferred, since it keeps the multiline PEM out of .env and the process
# environment. Both are resolved into the same in-memory value at startup.
#
# Option 1 (preferred): path to the .pem file downloaded from GitHub.
# GITHUB_PRIVATE_KEY_PATH=/path/to/your-github-app-private-key.pem
#
# Option 2: inline PEM. Escape newlines as \n if set on a single line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

GITHUB_WEBHOOK_SECRET=change-me

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT_SECONDS=10

# AI Reviewer (Phase 5, optional) -- credentials for whichever provider
# `.patchfrog.yml`'s `review.provider` selects (default: anthropic; see
# patchfrog.review.config.ReviewConfig). Never set either of these in
# .patchfrog.yml or any repository-controlled file; environment/secret-
# manager only. Leave unset to run static analysis and context generation
# without the AI reviewer -- `patchfrog.cli review` and the review Celery
# task both fail with a clear error (not a crash) if the *selected*
# provider's key is unset. Only the key for the provider actually
# configured needs to be set.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Gemini provider (patchfrog.review.providers.gemini_provider) -- select
# via .patchfrog.yml's `review: {provider: gemini, model: gemini-3.6-flash}`.
# GEMINI_API_KEY=...
